            tk.Label(grid, text=label, font=FONT_SUB, fg=TEXT, bg=BG,
                     anchor="w").grid(row=row, column=col, sticky="w", pady=3, padx=(0, 8))
            entry = tk.Entry(grid, textvariable=var, font=FONT_UI, bg=BG_INPUT,
                             fg=TEXT, relief="flat",
                             highlightbackground=BORDER, highlightthickness=1)
            entry.grid(row=row, column=col+1, sticky="ew", padx=(0, 16), pady=3, ipady=6)

        self._sep(parent)

        # ── 2. Kierunek i semestr ─────────────────────────────────────────────
        self._section_label(parent, "2  KIERUNEK I SEMESTR")
        ks_frame = tk.Frame(parent, bg=BG, padx=32)
        ks_frame.pack(fill="x")

        tk.Label(ks_frame, text="Kierunek:", font=FONT_SUB,
                 fg=TEXT, bg=BG).pack(anchor="w")
