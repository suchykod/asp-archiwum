        self._prac_outer = tk.Frame(parent, bg=BG, padx=32)
        self._prac_outer.pack(fill="x")

        self._no_data_label = tk.Label(
            self._prac_outer,
            text="⚠  Nie znaleziono pliku asp_pracownie.csv obok skryptu.\n"
                 "   Umieść plik CSV w tym samym folderze co skrypt i uruchom ponownie.",
