    def _build_semestr_buttons(self):
        for w in self._sem_frame.winfo_children():
            w.destroy()
        kierunek = self._kierunek_var.get()
        sems = SEMESTRY.get(kierunek, [])
        current = self._semestr_var.get()
        if current not in sems:
            self._semestr_var.set(sems[0] if sems else "")
        for s in sems:
            rb = tk.Radiobutton(
                self._sem_frame, text=s,
                variable=self._semestr_var, value=s,
                command=self._refresh_pracownie,
                bg=BG, activebackground=BG, selectcolor=GREEN,
                fg=TEXT, font=FONT_UI, relief="flat", bd=0
            )
            rb.pack(side="left", padx=4)

    def _on_kierunek_change(self):
        self._build_semestr_buttons()
        self._refresh_pracownie()

    def _refresh_pracownie(self):
        # Sprawdzamy czy lista istnieje przed próbą pobrania dzieci
        if not self._prac_frame.winfo_exists():
            return
            
        for w in self._prac_frame.winfo_children():
            w.destroy()
        self._check_vars.clear()

        if not self._db:
            self._no_data_label.pack(anchor="w")
            return
        self._no_data_label.pack_forget()

        kierunek = self._kierunek_var.get()
        semestr  = self._semestr_var.get()
        rows     = get_pracownie(self._db, kierunek, semestr)

        if not rows:
            tk.Label(self._prac_frame,
                     text="Brak danych dla tej kombinacji kierunku i semestru.",
                     font=FONT_SUB, fg=TEXT_DIM, bg=BG).pack(anchor="w")
            return

        # Grupuj po kategorii
        by_cat: dict[str, list] = {}
        for r in rows:
            cat = r["kategoria"]
            by_cat.setdefault(cat, []).append(r)

        for cat in KATEGORIE_ORDER:
            if cat not in by_cat:
                continue
            # Nagłówek kategorii
            cat_row = tk.Frame(self._prac_frame, bg=BG, pady=2)
            cat_row.pack(fill="x")
            
            # Usunięto argument pady z tk.Label i dodano do pack()
            tk.Label(cat_row, text=f" {cat.upper()} ", font=FONT_LABEL,
                     bg=GREEN, fg=BG_DARK, padx=6).pack(side="left", pady=2)

            for p in by_cat[cat]:
                key = p["kod_pracowni"]
                var = tk.BooleanVar(value=False)
                self._check_vars[key] = var

                row = tk.Frame(self._prac_frame, bg=BG)
                row.pack(fill="x", padx=8, pady=1)

                cb = tk.Checkbutton(
                    row, variable=var,
                    bg=BG, activebackground=BG, selectcolor=GREEN,
                    relief="flat", bd=0
                )
                cb.pack(side="left")

                code_lbl = tk.Label(row, text=f" {key} ",
                                    font=FONT_LABEL, bg="#eeeeee", fg=TEXT,
                                    padx=4)
                code_lbl.pack(side="left", padx=(2, 8), pady=1)

                tk.Label(row, text=p["nazwa_przedmiotu"],
                         font=FONT_SUB, fg=TEXT, bg=BG).pack(side="left")

                prow_short = p["prowadzacy"].split("/")[0].strip()
                tk.Label(row, text=f"  {prow_short}",
                         font=FONT_SMALL, fg=TEXT_DIM, bg=BG).pack(side="left")

    # ── Akcje ─────────────────────────────────────────────────────────────────

    def _pick_location(self):
        path = filedialog.askdirectory(title="Wybierz folder gdzie zapisać archiwum")
        if path:
            self._location_var.set(path)

    def _log(self, msg):
        self._log_box.config(state="normal")
        self._log_box.insert("end", msg + "\n")
        self._log_box.see("end")
        self._log_box.config(state="disabled")

    def _clear_log(self):
        self._log_box.config(state="normal")
        self._log_box.delete("1.0", "end")
        self._log_box.config(state="disabled")

    def _validate(self) -> bool:
        if not self._surname_var.get().strip():
            messagebox.showwarning("Brak danych", "Podaj nazwisko.")
            return False
        if not self._initial_var.get().strip():
            messagebox.showwarning("Brak danych", "Podaj inicjał imienia.")
            return False
        if not self._fullname_var.get().strip():
            messagebox.showwarning("Brak danych", "Podaj pełne imię i nazwisko.")
            return False
        if not self._album_var.get().strip():
            messagebox.showwarning("Brak danych", "Podaj nr albumu.")
            return False
        if not self._year_var.get().strip():
            messagebox.showwarning("Brak danych", "Podaj rok (np. 2026).")
            return False
        if not self._location_var.get().strip():
            messagebox.showwarning("Brak lokalizacji", "Wybierz gdzie zapisać archiwum.")
            return False
        selected = [k for k, v in self._check_vars.items() if v.get()]
        if not selected:
            messagebox.showwarning("Brak pracowni", "Zaznacz co najmniej jedną pracownię.")
            return False
        return True

    def _run(self):
        if not self._validate():
            return

        self._clear_log()
        self._run_btn.config(state="disabled", text="⏳  Tworzę strukturę…")

        # Zbierz dane
        surname   = self._surname_var.get().strip()
        initial   = self._initial_var.get().strip().upper()
        full_name = self._fullname_var.get().strip()
        album     = self._album_var.get().strip()
        year      = self._year_var.get().strip()
        semester  = self._semestr_var.get()
        location  = Path(self._location_var.get())
        kierunek  = self._kierunek_var.get()

        si = f"{surname}{initial}"  # np. SuchyW

        meta = {
            "surname_initial": si,
            "year":            year,
            "semester":        semester,
            "full_name":       full_name,
            "album":           album,
        }

        # Zbierz zaznaczone pracownie z bazy
        selected_codes = [k for k, v in self._check_vars.items() if v.get()]
        rows = get_pracownie(self._db, kierunek, semester)
        selected = [r for r in rows if r["kod_pracowni"] in selected_codes]

        self._log(f"Student:   {full_name}  (nr albumu: {album})")
        self._log(f"Kierunek:  {KIERUNKI[kierunek]}")
        self._log(f"Semestr:   {semester}  |  Rok: {year}")
        self._log(f"Pracownie: {', '.join(selected_codes)}\n")

        def worker():
            try:
                build_structure(None, location, meta, selected, self._log)
            except Exception as e:
                self._log(f"\n✗  Błąd: {e}")
            finally:
                self.after(0, lambda: self._run_btn.config(
                    state="normal", text="▶   Utwórz strukturę archiwum"))

        threading.Thread(target=worker, daemon=True).start()


if __name__ == "__main__":
    app = SetupWizard()
    app.mainloop()