        tk.Label(yr_row, text="Rok (np. 2026):", font=FONT_SUB,
                 fg=TEXT, bg=BG).pack(side="left", padx=(0, 8))
        tk.Entry(yr_row, textvariable=self._year_var, font=FONT_UI,
                 bg=BG_INPUT, fg=TEXT, width=8, relief="flat",
                 highlightbackground=BORDER, highlightthickness=1).pack(
                 side="left", ipady=5)

        self._sep(parent)

        # ── 3. Pracownie ──────────────────────────────────────────────────────
