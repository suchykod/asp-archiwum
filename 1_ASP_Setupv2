                                command=self._on_kierunek_change,
                                bg=BG, activebackground=BG,
                                selectcolor=GREEN, fg=TEXT, font=FONT_UI,
                                relief="flat", bd=0)
            rb.pack(side="left")
            tk.Label(row, text=f"{code}  –  {name}", font=FONT_SUB,
                     fg=TEXT, bg=BG).pack(side="left")

        # POPRAWKA BŁĘDU: Usunięto argument pady z tk.Label i dodano do pack()
        tk.Label(ks_frame, text="Semestr:", font=FONT_SUB,
                 fg=TEXT, bg=BG).pack(anchor="w", pady=(8, 0))
        
        self._sem_frame = tk.Frame(ks_frame, bg=BG)
        self._sem_frame.pack(anchor="w", pady=4)
        self._build_semestr_buttons()

        # ── Rok ───────────────────────────────────────────────────────────────
        yr_row = tk.Frame(ks_frame, bg=BG)
