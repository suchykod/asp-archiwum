        tk.Label(loc_frame,
                 text=f"Folder archiwum zostanie stworzony automatycznie jako  NazwiskoI_ROK_SEM",
                 font=FONT_SMALL, fg=TEXT_DIM, bg=BG).pack(anchor="w", pady=(4, 0))

        self._sep(parent)

        # ── Przycisk ──────────────────────────────────────────────────────────
        btn_frame = tk.Frame(parent, bg=BG, padx=32, pady=12)
        btn_frame.pack(fill="x")
