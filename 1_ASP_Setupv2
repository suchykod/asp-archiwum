            btn_frame, text="▶   Utwórz strukturę archiwum",
            font=("Helvetica Neue", 14, "bold") if IS_MAC else ("Arial", 12, "bold"),
            bg=GREEN, fg=BG_DARK,
            activebackground=GREEN_DARK, activeforeground=BG_DARK,
            relief="flat", padx=28, pady=12, cursor="hand2", bd=0,
            command=self._run
        )
        self._run_btn.pack(side="right")

        # ── Log ───────────────────────────────────────────────────────────────
        tk.Label(parent, text="LOG", font=FONT_LABEL, fg=TEXT_DIM,
                 bg=BG).pack(anchor="w", padx=32, pady=(8, 0))
        
        # POPRAWKA: Usunięto argument pady z tk.Frame i dodano do pack()
        log_frame = tk.Frame(parent, bg=BG, padx=32)
        log_frame.pack(fill="x", pady=(4, 24))
        
        self._log_box = scrolledtext.ScrolledText(
            log_frame, font=FONT_MONO, bg=BG_LOG, fg=TEXT,
            relief="flat", padx=12, pady=8, height=10,
